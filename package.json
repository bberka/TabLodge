{
	"name": "tablodge",
	"version": "0.1.3",
	"private": true,
	"description": "TabLodge: a cozy, local-only home for your tabs. Save and restore tab sessions and keep a bookmark board on your new tab (Chrome/Brave, Manifest V3).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bberka/TabLodge"
	},
	"homepage": "https://github.com/bberka/TabLodge",
	"bugs": {
		"url": "https://github.com/bberka/TabLodge/issues"
	},
	"author": "Berkay",
	"type": "module",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"build": "node scripts/build.ts && node scripts/verify-build.ts",
		"pack": "node scripts/package.ts",
		"dev": "node scripts/build.ts --watch --open-browser",
		"dev:seed": "node scripts/build.ts --watch --open-browser --seed-data",
		"browser:install": "playwright install chromium",
		"browser:startup": "node scripts/page-startup-check.ts",
		"skills:install": "npx skills experimental_install",
		"watch": "node scripts/build.ts --watch",
		"verify": "node scripts/verify-build.ts",
		"site:dev": "pnpm --filter tablodge-site dev",
		"site:build": "pnpm --filter tablodge-site build",
		"site:preview": "pnpm --filter tablodge-site preview",
		"version:next": "node scripts/release-version.ts next",
		"test": "vp test run",
		"test:watch": "vp test",
		"typecheck": "tsc -b",
		"lint": "xo",
		"lint:fix": "xo --fix",
		"format": "xo --fix",
		"check": "xo && tsc -b && vp test run",
		"a11y": "node scripts/a11y-check.ts",
		"test:private": "node scripts/private-storage-check.ts",
		"clean": "node --eval \"for (const dir of ['dist', 'node_modules/.tmp']) require('node:fs').rmSync(dir, { recursive: true, force: true })\""
	},
	"keywords": [
		"tab manager",
		"session manager",
		"bookmarks",
		"new tab",
		"chrome extension",
		"local-first",
		"privacy"
	],
	"dependencies": {
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-context-menu": "^2.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"lucide-react": "^0.468.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^2.6.1"
	},
	"devDependencies": {
		"@types/chrome": "^0.3.6",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"axe-core": "^4.14.0",
		"eslint-config-xo-react": "^0.32.0",
		"playwright": "^1.64.1",
		"tailwindcss": "3.4.17",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"xo": "^5.0.1"
	}
}
