{
	"name": "tablodge",
	"private": true,
	"description": "TabLodge: a cozy, local-only home for your tabs. Save and restore tab sessions and keep a bookmark board on your new tab (Chrome/Brave, Manifest V3).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bberka/TabLodge"
	},
	"homepage": "https://github.com/bberka/TabLodge",
	"bugs": {
		"url": "https://github.com/bberka/TabLodge/issues"
	},
	"author": "Berkay",
	"type": "module",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"prepare": "vp hooks enable --hooks-dir .hooks",
		"build": "pnpm --filter tablodge-extension run build",
		"pack": "pnpm --filter tablodge-extension run pack",
		"dev:chrome": "pnpm --filter tablodge-extension run dev:chrome",
		"dev:chrome:seed": "pnpm --filter tablodge-extension run dev:chrome:seed",
		"dev:chrome:headless": "pnpm --filter tablodge-extension run dev:chrome:headless",
		"dev:chrome:headless:seed": "pnpm --filter tablodge-extension run dev:chrome:headless:seed",
		"dev:firefox": "pnpm --filter tablodge-extension run dev:firefox",
		"dev:firefox:seed": "pnpm --filter tablodge-extension run dev:firefox:seed",
		"dev:firefox:headless": "pnpm --filter tablodge-extension run dev:firefox:headless",
		"dev:firefox:headless:seed": "pnpm --filter tablodge-extension run dev:firefox:headless:seed",
		"browser:install": "pnpm --filter tablodge-extension run browser:install",
		"browser:dev": "pnpm --filter tablodge-extension run browser:dev",
		"browser:startup": "pnpm --filter tablodge-extension run browser:startup",
		"browser:firefox": "pnpm --filter tablodge-extension run browser:firefox",
		"skills:install": "npx skills experimental_install",
		"watch": "pnpm --filter tablodge-extension run watch",
		"verify": "pnpm --filter tablodge-extension run verify",
		"site:dev": "pnpm --filter tablodge-site dev",
		"site:build": "pnpm --filter tablodge-site build",
		"site:preview": "pnpm --filter tablodge-site preview",
		"mobile:start": "pnpm --filter tablodge-mobile start",
		"mobile:android": "pnpm --filter tablodge-mobile android",
		"mobile:doctor": "pnpm --filter tablodge-mobile doctor",
		"mobile:apk": "pnpm --filter tablodge-mobile run apk",
		"mobile:export": "pnpm --filter tablodge-mobile exec expo export --platform android",
		"server:build": "pnpm --filter tablodge-sync-server build",
		"server:start": "pnpm --filter tablodge-sync-server start",
		"cf:setup": "pnpm --filter tablodge-sync-server cf:setup",
		"cf:deploy": "pnpm --filter tablodge-sync-server cf:deploy",
		"cf:dev": "pnpm --filter tablodge-sync-server cf:dev",
		"cf:delete": "pnpm --filter tablodge-sync-server cf:delete",
		"cf:bundle": "pnpm --filter tablodge-sync-server run cf:bundle",
		"version:next": "node scripts/release-version.ts next",
		"test": "vp test run",
		"test:watch": "vp test",
		"typecheck": "tsc -b",
		"lint": "xo",
		"lint:fix": "xo --fix",
		"format": "xo --fix",
		"check": "xo && tsc -b && vp test run",
		"a11y": "pnpm --filter tablodge-extension run a11y",
		"test:private": "pnpm --filter tablodge-extension run test:private",
		"clean": "pnpm --filter tablodge-extension run clean && node --eval \"require('node:fs').rmSync('node_modules/.tmp', { recursive: true, force: true })\""
	},
	"keywords": [
		"tab manager",
		"session manager",
		"bookmarks",
		"new tab",
		"chrome extension",
		"local-first",
		"privacy"
	],
	"devDependencies": {
		"@types/chrome": "^0.3.7",
		"@types/node": "^24.19.2",
		"eslint-config-xo-react": "^0.32.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"xo": "^5.0.1"
	}
}
