{
	// Build tooling run by Node (type stripping) or loaded by Vite+.
	"extends": "../../tsconfig/base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.extension-node.tsbuildinfo",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"erasableSyntaxOnly": true,
		"lib": ["ES2024"],
		"types": ["node"]
	},
	"include": ["vite.*.config.ts", "scripts/**/*.ts"]
}
