{
	"name": "tablodge-extension",
	"version": "0.0.0",
	"private": true,
	"description": "The TabLodge browser extension (Chrome, Brave, Firefox; Manifest V3).",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"scripts": {
		"build": "node scripts/build.ts && node scripts/verify-build.ts",
		"pack": "node scripts/package.ts",
		"dev:chrome": "node scripts/build.ts --target chrome --watch --open-browser",
		"dev:firefox": "node scripts/build.ts --target firefox --watch --open-browser",
		"browser:install": "playwright install chromium",
		"check:dev-browser": "node scripts/browser/dev-browser-check.ts",
		"check:startup": "node scripts/browser/page-startup-check.ts",
		"check:firefox": "node scripts/browser/firefox-smoke-check.ts",
		"watch": "node scripts/build.ts --watch",
		"check:build": "node scripts/verify-build.ts",
		"check:a11y": "node scripts/a11y/run.ts",
		"check:private-storage": "node scripts/private-storage-check.ts",
		"clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-context-menu": "^2.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tanstack/react-virtual": "^3.14.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"lucide-react": "^1.72.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^2.6.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.5",
		"@types/chrome": "^0.3.7",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/selenium-webdriver": "^4.35.7",
		"@vitejs/plugin-react": "^6.3.0",
		"axe-core": "^4.14.0",
		"linkedom": "^0.18.15",
		"playwright": "^1.65.0",
		"selenium-webdriver": "^4.52.0",
		"tailwindcss": "4.3.5",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
