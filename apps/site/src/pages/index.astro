---
import Base from '../layouts/Base.astro';
import ButtonIcon from '../components/ButtonIcon.astro';
import DownloadLink from '../components/DownloadLink.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import Screenshot from '../components/Screenshot.astro';
import {SITE, abs} from '../site';

const title = 'TabLodge: Tab Session Manager and Bookmark Board';
const description =
	'Free, open source tab session manager and bookmark board for Chrome, Brave, Edge and Firefox. Save tabs for later, restore tab groups, and keep your library private in your browser.';

const heroSizes = '(min-width: 920px) 880px, calc(100vw - 2.5rem)';

const features = [
	{title: 'Save tabs as sessions'},
	{title: 'Bookmark board on the new tab'},
	{title: 'Search sessions, bookmarks and open tabs'},
	{title: 'Import from OneTab, Session Buddy and Toby'},
	{title: 'Private windows with a lock'},
	{title: 'Sync through your own server'},
	{title: 'Android app'},
];

const steps = [
	{title: 'Save', text: 'Click the toolbar button to save one tab, a window, or everything open. The tabs close and the session stays in your library.'},
	{title: 'Find', text: 'Every new tab shows your sessions and bookmark board. Press the shortcut on any page to search all of it, open tabs included.'},
	{title: 'Restore', text: 'Open the whole session, or just the tabs you want. Tab groups come back as they were.'},
];

const faq = [
	{
		q: 'Is TabLodge free?',
		a: 'Yes. It is free and open source under the MIT license, with no paid tier and no account.',
	},
	{
		q: 'Which browsers and devices does it support?',
		a: 'Chrome, Brave, Edge, Vivaldi and Opera (version 116 or newer), and desktop Firefox 140 or newer. There is an Android app for Android 7 or newer. Safari and iPhone are not supported.',
	},
	{
		q: 'Does TabLodge collect any data?',
		a: 'No. There are no accounts, analytics, or telemetry. Your library stays in your browser profile, and TabLodge makes no network requests unless you turn on sync with a server you run.',
	},
	{
		q: 'How does sync work?',
		a: 'You run a small server with Docker or on your own Cloudflare account, then point the extension and the Android app at it. There is no TabLodge cloud. Without a server, export a backup on one device and import it on another.',
	},
	{
		q: 'Can I move over from OneTab, Session Buddy or Toby?',
		a: 'Yes. Import their export files, or Raindrop.io data, from Settings. See how TabLodge compares on the alternatives page.',
	},
	{
		q: 'What can the Android app do?',
		a: 'It saves links you share from other apps, or copy and then save with its Save link tile in Quick Settings, and shows, searches and opens your bookmarks and sessions. You can reorder bookmarks, rename, move, archive or delete sessions, and pick a light, dark or phone-matched theme. A phone browser cannot give another app its open tabs, so save sessions on a computer or share a list of links. The APK is on the latest release page, since there is no store listing yet.',
	},
	{
		q: 'Will TabLodge replace my new tab page?',
		a: 'Yes, it shows your bookmark board and sessions there. In Chromium browsers you can turn this off in Settings and use the popup, side panel or shortcuts instead. In Firefox it always replaces the new tab page.',
	},
];

const jsonLd = [
	{
		'@type': 'SoftwareApplication',
		'@id': `${SITE.url}/#software`,
		name: 'TabLodge',
		alternateName: 'TabLodge tab session manager',
		description,
		url: `${SITE.url}/`,
		image: abs(SITE.ogImage),
		applicationCategory: 'BrowserApplication',
		applicationSubCategory: 'Tab manager',
		operatingSystem: 'Windows, macOS, Linux, ChromeOS (Chromium-based browsers and desktop Firefox, Manifest V3)',
		browserRequirements: 'Requires a Chromium-based browser, version 116 or newer, or desktop Firefox 140 or newer',
		softwareVersion: SITE.version,
		downloadUrl: SITE.releases,
		installUrl: SITE.chromeWebStore,
		license: SITE.license,
		isAccessibleForFree: true,
		offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
		author: {'@type': 'Person', name: SITE.author},
		publisher: {'@id': `${SITE.url}/#organization`},
		codeRepository: SITE.repo,
		sameAs: [SITE.chromeWebStore, SITE.firefoxAddons, SITE.repo],
		screenshot: abs('/og.png'),
		featureList: features.map((f) => f.title),
	},
	{
		'@type': 'WebPage',
		'@id': `${SITE.url}/#webpage`,
		url: `${SITE.url}/`,
		name: title,
		description,
		about: {'@id': `${SITE.url}/#software`},
		isPartOf: {'@id': `${SITE.url}/#website`},
		primaryImageOfPage: {'@type': 'ImageObject', url: abs(SITE.ogImage)},
	},
	{
		'@type': 'MobileApplication',
		'@id': `${SITE.url}/#android`,
		name: 'TabLodge for Android',
		description: 'Save links from other apps, and open your TabLodge bookmarks and sessions on your phone.',
		url: `${SITE.url}/#android`,
		applicationCategory: 'ProductivityApplication',
		operatingSystem: 'Android 7.0 or newer',
		softwareVersion: SITE.version,
		downloadUrl: SITE.androidApk,
		license: SITE.license,
		isAccessibleForFree: true,
		offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
		author: {'@type': 'Person', name: SITE.author},
		codeRepository: SITE.repo,
	},
	{
		'@type': 'FAQPage',
		'@id': `${SITE.url}/#faq`,
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: {'@type': 'Answer', text: f.a},
		})),
	},
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">Free &amp; open source</p>
			<h1>Save your tabs. Find them again.</h1>
			<p class="lead">TabLodge saves your open tabs as named sessions, keeps a bookmark board on every new tab, and searches all of it. Your library stays in your browser, and it syncs to your phone through a server you run.</p>
<DownloadButtons>
				<a class="btn ghost" href="/alternatives/">Compare alternatives</a>
			</DownloadButtons>
			<p class="note">
				v{SITE.version} &middot; Chrome 116+ &middot; Firefox 140+ &middot; Android 7+ &middot; MIT license
			</p>
			<div class="hero-shot">
				<Screenshot
					name="dashboard"
					alt="TabLodge dashboard with a board of bookmark columns above saved tab sessions"
					sizes={heroSizes}
					eager
				/>
			</div>
		</div>
	</section>

	<section id="how" class="alt">
		<div class="wrap">
			<p class="eyebrow">How it works</p>
			<h2>Save now, find it later</h2>
			<ol class="steps">
				{
					steps.map((step, i) => (
						<li class="card">
							<h3><span class="num" aria-hidden="true">{i + 1}</span>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="extension">
		<div class="wrap">
			<p class="eyebrow">In your browser</p>
			<h2>Your tabs, organized</h2>
			<ul class="points">
				<li><strong>Sessions.</strong> Name them, color them, and sort them into folders. Archive the ones you are done with.</li>
				<li><strong>Bookmark board.</strong> Columns of links on every new tab, with link previews fetched through your own server.</li>
				<li><strong>Private windows.</strong> They get their own library, with an optional PIN or password lock.</li>
				<li><strong>Import and export.</strong> Bring data from OneTab, Session Buddy, Toby or Raindrop.io. Export as JSON, HTML, CSV or Markdown.</li>
			</ul>
		</div>
		<div class="wrap two">
			<div>
				<h3>Search everything</h3>
				<p>One box finds any session, bookmark or open tab, on any page.</p>
				<Screenshot
					name="palette"
					alt="TabLodge command palette searching for 'lis' and listing a session, a bookmark and saved tabs"
					sizes="(min-width: 900px) 540px, calc(100vw - 2.5rem)"
					widths={[540, 1080, 1520]}
				/>
			</div>
			<div class="side">
				<h3>Side panel</h3>
				<p>Browse sessions, bookmarks and open tabs beside the page you are on.</p>
				<div class="sidepanel-shot">
					<Screenshot
						name="sidepanel"
						alt="TabLodge side panel listing bookmark columns with a search box and Bookmarks, Sessions and Tabs tabs"
						sizes="(min-width: 900px) 320px, 60vw"
						widths={[420, 640, 840]}
					/>
				</div>
			</div>
		</div>
	</section>

	<section id="android" class="alt">
		<div class="wrap split">
			<div>
				<p class="eyebrow">On your phone</p>
				<h2>Your links, on Android</h2>
				<p class="lead">Share a link from any app to save it, then open your bookmarks and sessions anywhere. It syncs through the same server as the extension.</p>
				<ul class="points">
					<li>Share a browser's tabs to TabLodge to save them as bookmarks or a session.</li>
					<li>Swipe a bookmark to edit, move or delete it, or select several and open them together.</li>
					<li>Needs Android 7 or newer.</li>
				</ul>
				<p class="actions">
					<DownloadLink store="android" label="Download the APK" />
				</p>
			</div>
			<div class="phones">
				<div class="phone">
					<Screenshot
						name="android-bookmarks"
						alt="TabLodge Android app showing bookmark columns with icons, a list of saved links, and the floating tab bar"
						sizes="(min-width: 900px) 240px, 42vw"
						widths={[360, 540, 720]}
					/>
				</div>
				<div class="phone">
					<Screenshot
						name="android-sessions"
						alt="TabLodge Android app showing saved sessions filtered by folder, with the floating tab bar"
						sizes="(min-width: 900px) 240px, 42vw"
						widths={[360, 540, 720]}
					/>
				</div>
			</div>
		</div>
	</section>

	<section id="privacy">
		<div class="wrap">
			<p class="eyebrow">Private by design</p>
			<h2>No account, no cloud, no tracking</h2>
			<p class="lead">Your library stays in your browser. To sync between devices, run your own server with Docker or Cloudflare. TabLodge never sees your data. <a href="/privacy/">Read the privacy policy</a>.</p>
		</div>
	</section>

	<section id="compare" class="alt">
		<div class="wrap">
			<p class="eyebrow">Compare</p>
			<h2>How it stacks up</h2>
			<ul class="compare">
				<li class="card">
					<h3><a href="/alternatives/">Browser extensions</a></h3>
					<p>TabLodge next to OneTab, Session Buddy and Toby, feature by feature.</p>
				</li>
				<li class="card">
					<h3><a href="/alternatives/android/">Android apps</a></h3>
					<p>The Android app next to Raindrop.io, Linkwarden, Karakeep, wallabag and Instapaper.</p>
				</li>
			</ul>
		</div>
	</section>

	<section id="faq">
		<div class="narrow">
			<p class="eyebrow">FAQ</p>
			<h2>Quick answers</h2>
			<div class="faq">
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section id="install" class="cta alt">
		<div class="wrap center">
			<h2>Give your tabs a lodge</h2>
<DownloadButtons center />
		</div>
	</section>
</Base>

<style>
	.hero {
		padding-top: 4rem;
		padding-bottom: 3.5rem;
	}
	.hero h1 {
		max-width: 18ch;
	}
	.hero .lead {
		max-width: 46rem;
	}
	.hero-shot {
		margin-top: 2rem;
		max-width: 880px;
	}
	.steps,
	.compare {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.1rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 760px) {
		.steps {
			grid-template-columns: repeat(3, 1fr);
		}
		.compare {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.card {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.3rem 1.3rem 0.5rem;
	}
	.card p {
		color: var(--muted);
		font-size: 0.98rem;
	}
	.card h3:has(.num) {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}
	.num {
		flex: none;
		display: inline-grid;
		place-items: center;
		width: 1.8rem;
		height: 1.8rem;
		border-radius: 50%;
		background: var(--link);
		color: var(--bg);
		font-weight: 700;
		font-size: 0.95rem;
	}
	.compare h3 a {
		text-decoration: none;
	}
	.compare h3 a::after {
		content: ' \2192';
	}
	.two {
		display: grid;
		gap: 2.5rem;
		margin-top: 3rem;
		align-items: start;
	}
	.two p {
		color: var(--muted);
	}
	@media (min-width: 900px) {
		.two {
			grid-template-columns: 1fr 320px;
			gap: 4rem;
		}
	}
	.split {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1fr 1fr;
		}
	}
	.sidepanel-shot {
		max-width: 320px;
		width: 60vw;
	}
	.points {
		margin: 1rem 0 1.4rem;
		padding-left: 1.2rem;
		color: var(--muted);
	}
	.points strong {
		color: var(--text);
	}
	.phones {
		display: flex;
		gap: 1rem;
		justify-content: center;
		align-items: flex-start;
	}
	.phone {
		max-width: 240px;
		width: 42vw;
	}
	.faq details {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		margin-bottom: 0.7rem;
		padding: 0 1.2rem;
	}
	.faq summary {
		cursor: pointer;
		font-weight: 650;
		padding: 1rem 0;
	}
	.faq details[open] summary {
		color: var(--link);
	}
	.faq p {
		color: var(--muted);
	}
	.center {
		text-align: center;
	}
	.cta {
		padding-block: 5rem;
	}
</style>
