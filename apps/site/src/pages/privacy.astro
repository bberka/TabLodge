---
import Base from '../layouts/Base.astro';
import {SITE} from '../site';

const title = 'Privacy Policy: a Local-First Tab Manager | TabLodge';
const description =
	'TabLodge keeps your tab sessions and bookmarks on your device. No accounts, no TabLodge servers, no analytics. Optional sync goes only to a server you run. Read what it stores and why each permission is needed.';

const permissions = [
	['tabs', 'Reading tab URLs, titles and placement to save sessions; opening tabs to restore them.'],
	['tabGroups', 'Saving and recreating native tab groups.'],
	['bookmarks', 'Importing your browser bookmarks when you ask, and noticing a page you bookmark in the browser if you turn on that setting (off by default).'],
	['favicon (Chromium only)', 'Showing site icons from the browser\'s local cache.'],
	['storage, unlimitedStorage', 'Keeping your data in local extension storage without the default size cap.'],
	['contextMenus', 'Optional right-click save and bookmark actions.'],
	['clipboardWrite', 'Copying bookmark URLs and session links when you ask.'],
	['sidePanel (Chromium only)', 'Showing bookmarks, sessions and open tabs in the browser side panel. Firefox shows the same page in its sidebar, which needs no permission.'],
	['search', 'Running a web search with your default engine, only when you choose "Search the web".'],
	['alarms', 'Scheduling crash-recovery snapshots, automatic backups, trash bin cleanup, archiving old sessions, sync, and the idle lock of the private library.'],
	['idle', 'Noticing that you locked your screen, so the private library locks too. It reports only the lock state, never what you are doing.'],
	['activeTab, scripting', 'Used by the palette shortcut, which shows the palette over that one page when you press it (the default; Settings can switch to a window), and by Save quote, which shows its confirmation on the page you right-clicked. No install warning, no site access, and nothing runs on pages until you press the shortcut or choose the menu item.'],
	['downloads (optional)', 'Saving backup copies to your Downloads folder, only if you turn that on; turning it off gives the permission back.'],
	['https://www.youtube.com/* (optional)', 'Settings › Sources › YouTube Watch later: noticing when you add a video to Watch later, and on Watch later offering to add the videos not in TabLodge yet, only after you add it.'],
	['https://www.reddit.com/*, https://old.reddit.com/* (optional)', 'Settings › Sources › Reddit saved: noticing when you save a post or comment, and on your saved page offering to add the saved items not in TabLodge yet, only after you add it.'],
	['https://x.com/*, https://twitter.com/* (optional)', 'Settings › Sources › X bookmarks: noticing when you bookmark a post, and on your bookmarks offering to add the posts not in TabLodge yet, only after you add it.'],
	['https://www.instagram.com/* (optional)', 'Settings › Sources › Instagram saved: noticing when you save a post or reel, and on your saved posts offering to add the ones not in TabLodge yet, only after you add it.'],
	['https://github.com/* (optional)', 'Settings › Sources › GitHub stars: noticing when you star a repository, and on your own stars offering to add the repositories not in TabLodge yet, only after you add it.'],
	['https://news.ycombinator.com/* (optional)', 'Settings › Sources › Hacker News favorites: noticing when you favorite a story, only after you add it.'],
	['https://stackoverflow.com/* (optional)', 'Settings › Sources › Stack Overflow bookmarks: noticing when you bookmark a question, only after you add it.'],
	['https://dev.to/* (optional)', 'Settings › Sources › dev.to reading list: noticing when you save an article, only after you add it.'],
	['https://lobste.rs/* (optional)', 'Settings › Sources › Lobsters saved: noticing when you save a story, only after you add it.'],
	['https://bsky.app/* (optional)', 'Settings › Sources › Bluesky saved posts: noticing when you save a post, only after you add it.'],
	['https://soundcloud.com/*, https://m.soundcloud.com/* (optional)', 'Settings › Sources › SoundCloud likes: noticing when you like a track or playlist, only after you add it.'],
	['https://open.spotify.com/* (optional)', 'Settings › Sources › Spotify library: noticing when you save something to Your Library, only after you add it.'],
	['https://letterboxd.com/* (optional)', 'Settings › Sources › Letterboxd watchlist: noticing when you add a film to your watchlist, only after you add it.'],
	['https://www.imdb.com/*, https://m.imdb.com/* (optional)', 'Settings › Sources › IMDb watchlist: noticing when you add a title to your watchlist, only after you add it.'],
	['https://www.goodreads.com/* (optional)', 'Settings › Sources › Goodreads Want to Read: noticing when you mark a book Want to Read, only after you add it.'],
	['https://medium.com/*, https://*.medium.com/* (optional)', 'Settings › Sources › Medium reading list: noticing when you bookmark a story, only after you add it.'],
	['https://substack.com/*, https://*.substack.com/* (optional)', 'Settings › Sources › Substack saved: noticing when you save a post, only after you add it.'],
];
---

<Base
	title={title}
	description={description}
	path="/privacy/"
	breadcrumbs={[
		{name: 'Home', path: '/'},
		{name: 'Privacy', path: '/privacy/'},
	]}
	jsonLd={[
		{
			'@type': 'WebPage',
			'@id': 'https://tablodge.bbay.dev/privacy/#webpage',
			url: 'https://tablodge.bbay.dev/privacy/',
			name: title,
			description,
			dateModified: '2026-11-17',
			isPartOf: {'@id': 'https://tablodge.bbay.dev/#website'},
		},
	]}
>
	<article class="narrow prose page">
		<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Privacy</span></nav>
		<h1>Privacy</h1>
		<p class="note">Last updated: 2026-11-18</p>
		<p class="lead">
			TabLodge keeps your sessions, bookmarks and settings in your browser profile. It has no accounts or backend, and <strong>does not collect your data.</strong> It uploads your library only to a sync server you run yourself, and only after you connect one.
		</p>

		<h2>What TabLodge does not do</h2>
		<ul>
			<li>No accounts and no TabLodge servers or cloud. Optional sync talks only to a server you run yourself; it is off until you enter its address and token, and that server stores your library in plain text. A separate private window library syncs only if you turn that on too, and is encrypted in the browser when it has a password.</li>
			<li>No analytics, telemetry, crash reporting or advertising.</li>
			<li>No network requests of its own unless you turn on sync. All code, styles, fonts and icons are bundled in the extension; nothing is loaded from a CDN.</li>
			<li>No website access until you add a site in Sources. TabLodge declares no content scripts, and reads a page's contents only for a site you added in Sources or a page you choose Keep a copy for. The search palette is drawn over a page only when you press its shortcut, and Settings can switch it to a window.</li>
			<li>No sale or sharing of data with anyone.</li>
		</ul>

		<h2>What TabLodge stores, and where</h2>
		<p>Everything is stored locally in your browser profile:</p>
		<ul>
			<li><strong>Extension storage</strong> (<code>chrome.storage.local</code>, keys <code>tablodge.state</code>, <code>tablodge.session.*</code> and <code>tablodge.bookmarks.*</code>): your saved sessions (tab titles, URLs, notes, pinned, tab-group and split-view info), folders, bookmark columns and bookmarks with their notes, settings, and excluded websites.</li>
			<li><strong>Extension storage</strong> (<code>uiTheme</code>, <code>uiAccent</code>) and the extension's <code>localStorage</code> (<code>tablodge.uiTheme</code>, <code>tablodge.uiAccent</code>): your Light, Dark or System appearance choice and accent color, and a copy used to paint each page in the right theme before it loads.</li>
			<li><strong>Recovery data</strong> (extension storage): rolling snapshots of your open windows for crash recovery, automatic and safety backups, the trash bin, and short-lived Undo copies (kept for two minutes). After an update that changes how your library is stored, a full copy of the old library is kept for seven days. Snapshots skip private windows and excluded websites.</li>
		</ul>
		<p>
			TabLodge reads tab details to save and restore sessions, find duplicates, show and search open tabs, and capture recovery snapshots. Snapshots are enabled by default and can be turned off in Settings, under Recovery &amp; backups. It reads your browser's bookmark tree only when you ask to import it. If you enable the browser bookmark setting, it also watches for newly created bookmarks to offer to add that page or add it automatically. That setting is off by default. Site icons come from the browser's local favicon cache. Firefox has no such cache, so there TabLodge shows an open tab's own icon where the browser provides one, remembers the icon address of each site you open on this device only to show it for saved links to that site, and uses a letter tile for any other site.
		</p>
		<p>
			Saved sessions and bookmarks stay until you delete them. Trash is kept for 7, 30 or 90 days, depending on your setting. Snapshots, backups and Undo copies also have retention or size limits. You can clear recovery data in <strong>Settings &rsaquo; Recovery &amp; backups</strong>. Erasing sessions or bookmarks in <strong>Settings &rsaquo; Data</strong> creates a safety backup, so check the backup history too if you want to remove retained copies. Removing the extension deletes its browser storage.
		</p>
		<p>
			If you enable backup copies in Downloads, TabLodge writes JSON files to <code>Downloads/TabLodge/</code>. Turning the setting off or uninstalling does not delete those files. Exports, including JSON, HTML, CSV, Markdown, URL lists and full backup ZIP files, are not encrypted unless you protect a full backup with a password. If you do, TabLodge encrypts the file on your device (AES-256-GCM, with a key derived from your entry by PBKDF2) and stores neither the password nor a hint, so a lost one cannot be recovered. A short or number-only password is weak because anyone with the file can try every guess offline; use a long one for sensitive data. Automatic backups and Downloads copies are never encrypted. Keep unprotected files private if their titles, URLs or notes are sensitive. A folder synced by another app may upload them.
		</p>
		<p>
			With a sync server connected, <strong>Site icons</strong> in the extension and the Android app loads the icon of a site through your server, and is on by default. The extension asks only for sites the browser has no icon for and sends only the host name, and keeps the icons on your device. <strong>Preview links on hover</strong> in the extension, off by default, loads page previews the same way. Your server fetches the site, so the site sees your server and not your device, and no third party is involved. Without a server the extension asks for nothing. The Android app can also load an icon straight from each site when no server is connected, which tells that site your IP address.
		</p>
		<p>
			<strong>Shared pages</strong> are the one way TabLodge puts your data in front of people you did not pick, and only when you ask. With a sync server connected, <strong>Upload to my server</strong> in Share sends the web page Share would otherwise save as a file (titles, names, descriptions and links) to your server, which shows it to anyone who has its random link, without the token. Whoever has the link can open the page and pass it on. It stays on your server until you delete it in Settings › Sync › Shared pages. Private windows and the Android app's private library never upload a page.
		</p>
		<p>
			Opening a saved link loads that website normally. An optional setting, off by default, removes common tracking parameters from the destination when opening saved links or restoring sessions and snapshots. It leaves the URLs in your library unchanged. Choosing <strong>Search the web</strong> sends your query to the browser's default search engine. Choosing <strong>Open in Internet Archive</strong> on a saved link opens the Internet Archive's page for that address in a new tab, so the address goes to archive.org when you choose it. These are actions you request, not background reporting by TabLodge.
		</p>

		<h2>Sources</h2>
		<p>
			In <strong>Settings &rsaquo; Sources</strong> you can have TabLodge save a link when you save it on YouTube (Watch later), Reddit (a saved post or comment), X (a bookmarked post), Instagram (a saved post or reel), GitHub (a starred repository), Hacker News (a favorite story), Stack Overflow (a bookmarked question), dev.to (an article saved to your reading list), Lobsters (a saved story), Bluesky (a saved post), SoundCloud (a liked track or playlist), Spotify (something saved to Your Library), Letterboxd or IMDb (a film added to your watchlist), Goodreads (a book marked Want to Read), Medium (a bookmarked story), or Substack (a saved post). No site is on until you add it, and adding one asks the browser for access to that site only. Only then does TabLodge run a small script there, and removing the site, or removing its access in the browser, stops it.
		</p>
		<p>
			The script only notices your own click on the site's save control, then reads that item's address and its title, the start of a post's text, or the start of a caption from the page. On Hacker News and Lobsters it also reads the address of the story's discussion page, which goes in the bookmark's note. On your saved page on Reddit, YouTube (Watch later), X (bookmarks), Instagram, and GitHub (your own stars) it also reads the address and title of each saved item the page has loaded (on old Reddit also each saved comment's address and author, and on GitHub your user name, to tell your stars from someone else's), to count the ones not in TabLodge and add them only when you choose Add them. Choosing Not now keeps those missing addresses on this device in <code>tablodge.sourceCatchUp</code>, so it doesn't ask about them again; nothing is added, and removing the site clears them. It reads nothing else and sends nothing to the site or anywhere else. It leaves the site's own save alone, unless you set the site to <strong>Save to TabLodge only</strong>: then it stops that one click before the site sees it, so the item goes only into your library. It blocks no requests and doesn't stop the site learning from anything else you do there. The link is stored in your library like any other bookmark. Which sites are on, their column, and their save mode are kept in <code>tablodge.sources</code>, and sync to your other browsers only through your own sync server; each browser still asks for its own access to a site. In a private window, a save is added only when private windows use the regular library.
		</p>

		<h2>Private windows</h2>
		<p>The Firefox version does not run in private windows, so it cannot read or save them, and the rest of this section applies to Chromium browsers.</p>
		<p>After you enable Allow in Incognito in your browser's extension settings, the first private dashboard visit requires a storage choice. By default, private windows use the same library as regular windows, so private saves appear in the shared library. You can instead use a separate saved library in local extension storage or a separate temporary library in browser session storage. Temporary data clears on browser restart, not when private windows close. Both separate libraries start empty. Switching modes does not copy, merge or delete data. Appearance remains shared. New private tabs redirect to the TabLodge dashboard by default; you can turn this off in Settings under Private windows.</p>
		<p>The storage choice and redirect preference are kept in <code>tablodge.private.config</code>; separate library and recovery keys have the prefix <code>tablodge.private.</code>. The redirect preference does not record private browsing activity. Saved private data is not encrypted or hidden from someone with access to your browser profile unless you lock it. You can lock a separate saved library with a password in Settings under Private windows. TabLodge then encrypts every value of it on your device, keeps the key only in memory until you lock it, the idle time passes, you lock your screen, the last private window closes or the browser closes, and stores no copy of the password, so a lost one cannot be recovered. A short or number-only password is weak against someone who copies your profile files, and exports from an unlocked private library are plain unless you protect a full backup. Temporary data also clears if the extension is disabled, reloaded or updated. Automatic snapshots, automatic backups and browser bookmark monitoring do not run in private windows. Explicit exports and manual backup downloads can still leave files on disk after temporary data clears. To erase a saved private library and its recovery copies, select that mode and open Settings from its private dashboard.</p>

		<h2>Android app</h2>
		<p>
			The Android app uses the same sync and sends the same data to the same server, and nothing to anyone else. It uses the internet to reach that server, and asks Android to let it install an update you download. While a server is connected, it also syncs with it about every 15 minutes with the app closed, unless you turn off <strong>Sync in the background</strong> in Settings › Sync; the private library is not part of that. To schedule it, Android's WorkManager adds the permissions to run after a restart, check for a network, keep the phone awake while the work runs, and run a foreground service. The server token is kept in the Android keystore and your library in a database only the app can read. It never reads other apps or your browser: it sees a link only when you type it or share it to TabLodge, or when you tap the Save link tile in Quick Settings, which reads the clipboard once to fill in the link. The tiles store nothing. For the Bookmarks home screen widget, the app keeps a copy of your regular bookmark columns (names and up to 50 links each) in its private files; the private library is never copied, and erasing your bookmarks deletes the copy. An export file or backup you share to TabLodge is read once to show the import preview or restore it; a photo or other file is refused. Either way the copy Android hands over is deleted at once. The phone can also keep a private library of its own, which works without a server. It always has a password, and only a copy of its random data key wrapped by that password is kept. The library syncs to your server sealed with that key, and without a server it never leaves the phone. A library from an earlier version that has no password does not sync until it gets one. Erasing the library removes it and its password. Restoring a backup keeps a copy of what it replaced in the app's private storage until the next restore. Disconnecting removes the token and the sync position and leaves the library on the phone.
		</p>

		<h2>Permissions</h2>
		<div class="table-wrap">
			<table>
				<thead><tr><th scope="col">Permission</th><th scope="col">Used for</th></tr></thead>
				<tbody>
					{permissions.map(([name, use]) => <tr><th scope="row"><code>{name}</code></th><td>{use}</td></tr>)}
				</tbody>
			</table>
		</div>

		<h2>This website</h2>
		<p>
			This site (tablodge.bbay.dev) is a static page with no analytics, cookies or third-party scripts. It is hosted on GitHub Pages, which, like any web host, may keep ordinary server logs; see <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub's privacy statement</a>. Manual release downloads are served by GitHub Releases. Store listings, installations, and updates are handled by Google through the <a href={SITE.chromeWebStore} rel="noopener">Chrome Web Store</a> and by Mozilla through <a href={SITE.firefoxAddons} rel="noopener">Firefox Add-ons</a>.
		</p>

		<h2>Contact</h2>
		<p>Questions or concerns: <a href={SITE.issues} rel="noopener">open an issue on GitHub</a>.</p>
	</article>
</Base>

<style>
	.page {
		padding-block: 3rem 5rem;
	}
	.crumbs {
		font-size: 0.9rem;
		color: var(--muted);
		margin-bottom: 1rem;
	}
</style>
