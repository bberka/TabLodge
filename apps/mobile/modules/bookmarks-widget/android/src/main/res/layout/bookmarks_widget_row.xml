<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bookmarks_widget_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?android:attr/selectableItemBackground"
  android:gravity="center_vertical"
  android:minHeight="48dp"
  android:orientation="horizontal"
  android:paddingStart="8dp"
  android:paddingEnd="8dp"
  android:paddingTop="4dp"
  android:paddingBottom="4dp">

  <TextView
    android:id="@+id/bookmarks_widget_letter"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:background="@drawable/bookmarks_widget_letter"
    android:gravity="center"
    android:importantForAccessibility="no"
    android:textColor="@color/bookmarks_widget_on_accent"
    android:textSize="14sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/bookmarks_widget_row_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:textColor="@color/bookmarks_widget_text"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/bookmarks_widget_row_host"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:textColor="@color/bookmarks_widget_text_secondary"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
