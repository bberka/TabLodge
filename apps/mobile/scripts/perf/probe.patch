diff --git a/apps/mobile/src/platform/perf-probe.ts b/apps/mobile/src/platform/perf-probe.ts
new file mode 100644
index 00000000..5766420e
--- /dev/null
+++ b/apps/mobile/src/platform/perf-probe.ts
@@ -0,0 +1,44 @@
+/*
+Timing marks for profiling a large library on a phone or emulator (issue #436). Everything here is off unless the
+bundle is built with EXPO_PUBLIC_PERF=1, which Expo inlines, so the shipped app keeps none of it. Marks go to logcat
+as `PERF {...}` lines; scripts/perf/run-matrix.sh reads them.
+*/
+export const PERF =
+	// eslint-disable-next-line n/prefer-global/process -- Expo inlines the literal `process.env.EXPO_PUBLIC_*` at bundle time
+	process.env.EXPO_PUBLIC_PERF === '1';
+
+const seen = new Set<string>();
+
+export function perfLog(fields: Record<string, unknown>): void {
+	if (PERF) {
+		console.log(`PERF ${JSON.stringify({...fields, at: Math.round(performance.now())})}`);
+	}
+}
+
+/**
+Logs the first time only, for "first rows shown" style marks.
+*/
+export function perfOnce(name: string, fields: Record<string, unknown> = {}): void {
+	if (PERF && !seen.has(name)) {
+		seen.add(name);
+		perfLog({mark: name, ...fields});
+	}
+}
+
+export async function perfTime<T>(
+	name: string,
+	work: () => T | Promise<T>,
+	fields: Record<string, unknown> = {},
+): Promise<T> {
+	const start = performance.now();
+	const result = await work();
+	perfLog({step: name, ms: Math.round((performance.now() - start) * 10) / 10, ...fields});
+	return result;
+}
+
+export function perfSync<T>(name: string, work: () => T, fields: Record<string, unknown> = {}): T {
+	const start = performance.now();
+	const result = work();
+	perfLog({step: name, ms: Math.round((performance.now() - start) * 10) / 10, ...fields});
+	return result;
+}
diff --git a/apps/mobile/src/platform/perf-run.ts b/apps/mobile/src/platform/perf-run.ts
new file mode 100644
index 00000000..afae73c6
--- /dev/null
+++ b/apps/mobile/src/platform/perf-run.ts
@@ -0,0 +1,129 @@
+/*
+Profiling run for a large library (issue #436), only in a bundle built with EXPO_PUBLIC_PERF=1. On the first start of
+an installed build it connects to the sync server the scripts filled (a pull of the whole library), then times the work
+the screens and the transfer sheets do on that library, in Hermes, and disconnects. Later starts do nothing, so a cold
+start can be timed on the saved library.
+*/
+import {randomUUID} from 'expo-crypto';
+import {parseImportFile} from '../../../extension/src/shared/import-formats';
+import {normalizeStore} from '../../../extension/src/shared/library-normalize';
+import {
+	allBookmarks,
+	bookmarksIn,
+	columnViews,
+	searchBookmarks,
+	updateBookmark,
+} from '../library/board-edits';
+import {
+	connectServer,
+	disconnectServer,
+	editRegular,
+	getLibrary,
+	syncClient,
+} from '../library/library-store';
+import {
+	renameSession,
+	searchSessions,
+	sessionFolders,
+	sessionsIn,
+} from '../library/session-edits';
+import {searchElsewhere} from '../library/search-elsewhere';
+import {buildWidgetSnapshot} from '../library/widget-snapshot';
+import {buildBackup, readBackup} from '../transfer/backup';
+import {importIntoStore, previewFor} from '../transfer/transfer';
+import {readJson, writeJson} from './storage';
+import {perfLog, perfSync, perfTime} from './perf-probe';
+
+const SERVER = 'http://localhost:18917';
+const TOKEN = 'perf-token-perf-token-perf-token-0123456789';
+const DONE_KEY = 'tablodge.perf.done';
+const LOCAL_KEY = 'tablodge.perf.local';
+
+function importFile(count: number): string {
+	const rows = Array.from(
+		{length: count},
+		(_, index) => `<DT><A HREF="https://import.example/${index}">Imported ${index}</A>`,
+	);
+	return `<!DOCTYPE NETSCAPE-Bookmark-file-1><DL><p><DT><H3>Imported</H3><DL><p>${rows.join('\n')}</DL><p></DL><p>`;
+}
+
+export async function runPerf(): Promise<void> {
+	if ((await readJson(DONE_KEY)) !== undefined) {
+		return;
+	}
+
+	await writeJson(DONE_KEY, true);
+	// The library was put into the phone's storage directly (a library too large to sync in reasonable time).
+	const local = (await readJson(LOCAL_KEY)) !== undefined;
+	if (!local) {
+		await perfTime('sync-pull', async () => connectServer(SERVER, TOKEN));
+	}
+
+	const store = getLibrary();
+	const defaultSort = 'newest' as const;
+	const stats = {
+		bookmarks: store.bookmarks.length,
+		columns: store.bookmarkColumns.length,
+		sessions: store.groups.length,
+		links: store.groups.reduce((sum, group) => sum + group.tabs.length, 0),
+		folders: store.folders.length,
+	};
+	perfLog({step: 'library', ...stats});
+	perfSync('stringify', () => JSON.stringify(store).length);
+	const text = JSON.stringify(store);
+	perfSync('parse', () => JSON.parse(text) as unknown, {bytes: text.length});
+	perfSync('normalizeStore', () => normalizeStore(store as never));
+	// What the Bookmarks screen computes for All and for one column, and for a search.
+	perfSync('allBookmarks', () => allBookmarks(store).length);
+	perfSync('columnViews', () => columnViews(store).length);
+	if (store.bookmarkColumns[0]) {
+		perfSync('bookmarksIn', () => bookmarksIn(store, store.bookmarkColumns[0].id).length);
+	}
+
+	perfSync('searchBookmarks', () => searchBookmarks(store, 'guide').length);
+	perfSync('searchSessions', () => searchSessions(store.groups, 'guide', store.folders).length);
+	// The same search again, and a second word: what typing the next letter costs once the first key has paid for any caching.
+	perfSync('searchBookmarks-again', () => searchBookmarks(store, 'guid').length);
+	perfSync('searchSessions-again', () => searchSessions(store.groups, 'guid', store.folders).length);
+	// A query with no match, which opens the results from the other places: it builds an index of the whole library.
+	perfSync('searchElsewhere-miss', () => searchElsewhere(store, 'zzzzq', 'sessions').length);
+	perfSync('searchElsewhere-miss-again', () => searchElsewhere(store, 'zzzzqq', 'sessions').length);
+	perfSync('sessionFolders', () => sessionFolders(store).length);
+	perfSync('sessionsIn', () => sessionsIn(store, 'all', defaultSort).length);
+	perfSync('widgetSnapshot', () => buildWidgetSnapshot(store, {how: 'default' as never, app: ''}));
+	// One edit: JS work, the screen store update, and the SQLite save, then the push of that one change.
+	await perfTime('edit', async () =>
+		editRegular((current) => {
+			const first = current.bookmarks[0];
+			if (first) {
+				return updateBookmark(
+					current,
+					first.id,
+					{title: 'Edited once', url: first.url, columnId: first.columnId},
+					Date.now(),
+				);
+			}
+
+			const session = current.groups[0];
+			return session ? renameSession(current, session.id, 'Edited once', Date.now()) : current;
+		}),
+	);
+	if (!local) {
+		await perfTime('sync-push', async () => syncClient.syncNow());
+	}
+
+	const backup = await perfTime('export', async () => buildBackup(getLibrary(), 'TabLodge'));
+	perfLog({step: 'export-size', bytes: backup.bytes.length});
+	await perfTime('import-backup', async () => readBackup(backup.bytes));
+	const file = importFile(1000);
+	const parsed = perfSync('import-parse-1000', () => parseImportFile(file));
+	perfSync('import-preview-1000', () => previewFor(getLibrary(), parsed, 'bookmarks'));
+	perfSync('import-apply-1000', () =>
+		importIntoStore(getLibrary(), parsed, {kind: 'bookmarks', now: Date.now(), newId: randomUUID}),
+	);
+	if (!local) {
+		await disconnectServer();
+	}
+
+	perfLog({step: 'done'});
+}
