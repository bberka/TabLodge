{
	// Extension pages and the theme boot script (DOM environment).
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["chrome", "vite-plus/client"]
	},
	"include": ["src", "extension/*.ts"],
	"exclude": ["extension/service-worker.ts"]
}
