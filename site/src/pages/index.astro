---
import Base from '../layouts/Base.astro';
import ButtonIcon from '../components/ButtonIcon.astro';
import Screenshot from '../components/Screenshot.astro';
import {SITE, abs} from '../site';
import {screenshotSet} from '../lib/screens';

const title = 'TabLodge: Save Tabs for Later';
const description =
	'Save tab sessions and bookmarks in your Chromium browser. Free, open source, and private.';

const heroDark = await screenshotSet('dashboard', 'dark');
const heroLight = await screenshotSet('dashboard', 'light');
const heroSizes = '(min-width: 1160px) 1120px, calc(100vw - 2.5rem)';

const features = [
	{title: 'Save tabs as sessions', text: 'Save one tab, selected tabs, or a whole window for later.'},
	{title: 'Restore with tab groups', text: 'Bring back group names, colors, and collapsed state.'},
	{title: 'A bookmark board on your new tab', text: 'Keep links in columns, add them by dragging or pasting, and switch between a Board grid and a Focus view that opens one column at a time. Large columns scroll inside a capped pane by default, and you can set the column width, columns per row, and a compact density.'},
	{title: 'Search everything', text: 'Find sessions, saved tabs, bookmarks, and open tabs together, type tl in the address bar, or open the search palette from any page with a keyboard shortcut, over the current page or in a window.'},
	{title: 'Organize your sessions', text: 'Sort sessions into folders, archive them manually or automatically, merge without duplicates, refresh a session from the current window, split one in two, and undo changes.'},
	{title: 'Flexible restores', text: 'Restore in this or a new window, skip duplicates, and choose what stays open. An optional setting removes common tracking parameters when opening or copying saved links.'},
	{title: 'Close duplicate tabs', text: 'Close extra copies of the same page in one click. The most recently used copy stays, pinned and visible tabs are never closed, and Undo reopens what you closed.'},
	{title: 'Clean up duplicate bookmarks', text: 'Find addresses saved more than once on your bookmark board, keep the copy you want, and remove the rest. Removed copies go to the trash bin and Undo brings them back.'},
	{title: 'Side panel and quick actions', text: 'Browse your library from the side panel, popup, menus, or shortcuts.'},
	{title: 'Import and back up', text: 'Import from other tab tools or export selected data or a full backup.'},
];

const faq = [
	{
		q: 'Is TabLodge free?',
		a: 'Yes. TabLodge is free and open source under the MIT license. There is no paid tier, no account and no limit on saved tabs other than your browser storage.',
	},
	{
		q: 'Is TabLodge on the Chrome Web Store?',
		a: 'Yes. Install TabLodge from the Chrome Web Store in Chrome, Brave, Edge, Vivaldi, Opera, or another compatible Chromium browser.',
	},
	{
		q: 'Which browsers does TabLodge support?',
		a: 'Chromium-based browsers that support Manifest V3 and Chrome 116 or newer: Google Chrome, Brave, Microsoft Edge, Vivaldi, Opera and others. Split-view restore needs Chromium 155 or newer; older versions open those tabs side by side as normal tabs. TabLodge also runs on desktop Firefox 140 or newer. The Firefox package on the release page is not signed or listed on Firefox Add-ons yet, so Firefox loads it as a temporary add-on. Safari and mobile browsers are not supported.',
	},
	{
		q: 'Can I use TabLodge in private windows?',
		a: 'In Chromium, enable Allow in Incognito in the browser’s extension settings. New private tabs redirect to the TabLodge dashboard by default. Turn this off in Settings under Private windows to keep the browser’s private new tab page. You can also open the dashboard from the toolbar popup or its shortcut. The first private visit asks whether to use the same library as regular windows, use a separate saved library, or use a separate temporary library that clears on browser restart. A separate saved library can be locked with a PIN or password, which encrypts it on your device and shows a lock screen in private windows. It locks again when the last private window closes. A lost PIN or password cannot be recovered. Firefox private windows are not supported: TabLodge does not run there.',
	},
	{
		q: 'Does TabLodge collect any data?',
		a: 'No. TabLodge has no servers, accounts, analytics or telemetry, and it makes no network requests of its own unless you turn on sync with a server you run yourself. It requests no website permissions and injects nothing into pages, except that the search palette shortcut draws the palette over the page you pressed it on, and only when you press it (Settings can switch it to a window). Your sessions and bookmarks are stored in your browser profile.',
	},
	{
		q: 'Does it sync between my computers?',
		a: 'Yes, through a sync server you run yourself, with Docker or on your own Cloudflare account. There is no TabLodge cloud. Connect each browser in Settings under Sync, and sessions, bookmarks and display preferences stay the same on all of them, with changes showing up within a moment. The server stores your library in plain text, so run it somewhere you trust. Private windows with their own library can sync too if you turn it on, encrypted when they have a PIN or password. The self hosting guide (docs/self-hosting.md in the TabLodge repository) walks through a VPS with Docker and automatic HTTPS, Cloudflare, and backups. Without a server, save a full backup (one ZIP with everything, settings included) on one machine and import it on another.',
	},
	{
		q: 'Can I import my tabs from OneTab, Session Buddy, Tab Session Manager or Toby?',
		a: 'Yes. Open Settings, choose Data, then import the file you exported from the other tool. You get a review screen before anything is saved, and duplicates can be skipped.',
	},
	{
		q: 'Will TabLodge replace my new tab page?',
		a: 'Yes, it shows your bookmark board and sessions on the new tab page. If you would rather keep your current new tab, turn it off in Settings and use the toolbar popup, side panel or shortcuts instead. In Firefox the setting is hidden: Firefox does not let an add-on hand a new tab back to its own page, so the new tab page stays TabLodge while the add-on is enabled.',
	},
	{
		q: 'How do I update TabLodge?',
		a: 'Chrome Web Store installations update automatically in supported Chromium browsers. A Firefox package loaded from the release page does not update itself; load the new release over it.',
	},
];

const jsonLd = [
	{
		'@type': 'SoftwareApplication',
		'@id': `${SITE.url}/#software`,
		name: 'TabLodge',
		alternateName: 'TabLodge tab session manager',
		description,
		url: `${SITE.url}/`,
		image: abs(SITE.ogImage),
		applicationCategory: 'BrowserApplication',
		applicationSubCategory: 'Tab manager',
		operatingSystem: 'Windows, macOS, Linux, ChromeOS (Chromium-based browsers, Manifest V3)',
		browserRequirements: 'Requires a Chromium-based browser, version 116 or newer',
		softwareVersion: SITE.version,
		downloadUrl: SITE.releases,
		installUrl: SITE.chromeWebStore,
		license: SITE.license,
		isAccessibleForFree: true,
		offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
		author: {'@type': 'Person', name: SITE.author},
		publisher: {'@id': `${SITE.url}/#organization`},
		codeRepository: SITE.repo,
		screenshot: abs('/og.png'),
		featureList: features.map((f) => f.title),
	},
	{
		'@type': 'FAQPage',
		'@id': `${SITE.url}/#faq`,
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: {'@type': 'Answer', text: f.a},
		})),
	},
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/webp"
		imagesrcset={heroDark.srcset}
		imagesizes={heroSizes}
		media="(prefers-color-scheme: dark)"
		fetchpriority="high"
	/>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/webp"
		imagesrcset={heroLight.srcset}
		imagesizes={heroSizes}
		media="(prefers-color-scheme: light)"
		fetchpriority="high"
	/>

	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">Free &amp; open source</p>
			<h1>Sessions and bookmarks in one quiet place.</h1>
			<p class="lead">Save tabs for later. Restore them with tab groups intact.</p>
			<div class="actions">
				<a class="btn primary" href={SITE.chromeWebStore} rel="noopener"><ButtonIcon kind="store" />Install from Chrome Web Store</a>
				<a class="btn ghost" href={SITE.repo} rel="noopener"><ButtonIcon kind="github" />View on GitHub</a>
			</div>
			<p class="note">
				TabLodge v{SITE.version} &middot; Chrome 116+ &middot; MIT license
			</p>
			<div class="hero-shot">
				<Screenshot
					name="dashboard"
					alt="TabLodge dashboard with saved tab sessions above a board of bookmark columns"
					sizes={heroSizes}
					eager
				/>
			</div>
		</div>
	</section>

	<section id="features" class="alt">
		<div class="wrap">
			<p class="eyebrow">Features</p>
			<h2>Everything you need to keep tabs under control</h2>
			<ul class="grid">
				{
					features.map((f) => (
						<li class="card">
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section>
		<div class="wrap split">
			<div>
				<p class="eyebrow">Search</p>
				<h2>Find it all.</h2>
				<p class="lead">Search sessions, bookmarks, and open tabs in one place.</p>
			</div>
			<Screenshot
				name="palette"
				alt="TabLodge command palette searching for 'lis' and listing a session, a bookmark and saved tabs"
				sizes="(min-width: 900px) 540px, calc(100vw - 2.5rem)"
				widths={[540, 1080, 1520]}
			/>
		</div>
	</section>

	<section class="alt">
		<div class="wrap split reverse">
			<div class="sidepanel-shot">
				<Screenshot
					name="sidepanel"
					alt="TabLodge side panel listing bookmark columns with a search box and Bookmarks, Sessions and Tabs tabs"
					sizes="(min-width: 900px) 320px, 60vw"
					widths={[420, 640, 840]}
				/>
			</div>
			<div>
				<p class="eyebrow">Side panel</p>
				<h2>Always one click away</h2>
				<p class="lead">Browse sessions, bookmarks, and open tabs beside your page.</p>
			</div>
		</div>
	</section>

	<section id="privacy">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Privacy</p>
				<h2>Your tabs stay yours</h2>
				<p class="lead">Your library stays in your browser. No account, tracking, or website access.</p>
			</div>
			<p><a class="btn ghost" href="/privacy/">Read the privacy policy</a></p>
		</div>
	</section>

	<section id="install" class="alt">
		<div class="wrap split">
			<div>
				<h2>Get TabLodge</h2>
				<p>Available in Chrome, Brave, Edge, Vivaldi, Opera, and other Chromium browsers. Updates are automatic. TabLodge opens the dashboard in a new tab after installation.</p>
				<p>Using desktop Firefox 140 or newer? Download the unsigned Firefox package from the <a href={SITE.releases} rel="noopener">latest release</a>; the README explains how to load it.</p>
				<p><a class="btn primary" href={SITE.chromeWebStore} rel="noopener"><ButtonIcon kind="store" />Install from Chrome Web Store</a></p>
			</div>
		</div>
	</section>

	<section id="faq" class="alt">
		<div class="narrow">
			<p class="eyebrow">FAQ</p>
			<h2>Quick answers</h2>
			<div class="faq">
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="wrap center">
			<h2>Give your tabs a lodge</h2>
			<div class="actions center">
				<a class="btn primary" href={SITE.chromeWebStore} rel="noopener"><ButtonIcon kind="store" />Install from Chrome Web Store</a>
				<a class="btn ghost" href={SITE.repo} rel="noopener"><ButtonIcon kind="github" />View on GitHub</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero {
		padding-top: 3.5rem;
		padding-bottom: 3rem;
	}
	.hero h1 {
		max-width: 18ch;
	}
	.hero-shot {
		margin-top: 2.2rem;
	}
	.grid {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
	}
	.card {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.3rem 1.3rem 0.5rem;
	}
	.card p {
		color: var(--muted);
		font-size: 0.98rem;
	}
	.split {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1fr 1fr;
		}
		.split.reverse {
			grid-template-columns: 320px 1fr;
			gap: 4rem;
		}
	}
	.sidepanel-shot {
		max-width: 320px;
		width: 60vw;
		justify-self: center;
	}
	.faq details {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		margin-bottom: 0.7rem;
		padding: 0 1.2rem;
	}
	.faq summary {
		cursor: pointer;
		font-weight: 650;
		padding: 1rem 0;
	}
	.faq details[open] summary {
		color: var(--link);
	}
	.faq p {
		color: var(--muted);
	}
	.center {
		text-align: center;
	}
	.actions.center {
		justify-content: center;
	}
	.cta {
		padding-block: 5rem;
	}
</style>
