---
import Base from '../layouts/Base.astro';
import ButtonIcon from '../components/ButtonIcon.astro';
import Screenshot from '../components/Screenshot.astro';
import {SITE, abs} from '../site';
import {screenshotSet} from '../lib/screens';

const title = 'TabLodge: Save Tabs for Later';
const description =
	'Save tab sessions and bookmarks in Chromium browsers and Firefox. Free, open source, and private.';

const heroDark = await screenshotSet('dashboard', 'dark');
const heroLight = await screenshotSet('dashboard', 'light');
const heroSizes = '(min-width: 1160px) 1120px, calc(100vw - 2.5rem)';

const features = [
	{title: 'Save tabs as sessions', text: 'Save one tab, a window, or everything open, name it, and restore it whenever you want.'},
	{title: 'Bookmark board', text: 'Columns of links on every new tab, ready when you open one.'},
	{title: 'Search everything', text: 'Find any session, bookmark, or open tab from one search box, on any page.'},
	{title: 'Import, back up, sync', text: 'Bring data from OneTab, Session Buddy, or Toby, and sync through a server you run.'},
];

const faq = [
	{
		q: 'Is TabLodge free?',
		a: 'Yes. It is free and open source under the MIT license, with no paid tier and no account.',
	},
	{
		q: 'Which browsers does TabLodge support?',
		a: 'Chromium-based browsers on Chrome 116 or newer, such as Chrome, Brave, Edge, Vivaldi, and Opera. Desktop Firefox 140 or newer works too, from Firefox Add-ons. Safari and mobile browsers are not supported.',
	},
	{
		q: 'Does TabLodge collect any data?',
		a: 'No. There are no accounts, analytics, or telemetry, and it makes no network requests unless you turn on sync with a server you run. Your library is stored in your browser profile.',
	},
	{
		q: 'Does it sync between my computers?',
		a: 'Yes, through a server you run yourself with Docker or on your Cloudflare account. There is no TabLodge cloud. Without a server, save a backup on one machine and import it on another.',
	},
	{
		q: 'Will TabLodge replace my new tab page?',
		a: 'Yes, it shows your bookmark board and sessions there. In Chromium browsers you can turn this off in Settings and use the popup, side panel, or shortcuts instead. In Firefox it always replaces the new tab page.',
	},
];

const jsonLd = [
	{
		'@type': 'SoftwareApplication',
		'@id': `${SITE.url}/#software`,
		name: 'TabLodge',
		alternateName: 'TabLodge tab session manager',
		description,
		url: `${SITE.url}/`,
		image: abs(SITE.ogImage),
		applicationCategory: 'BrowserApplication',
		applicationSubCategory: 'Tab manager',
		operatingSystem: 'Windows, macOS, Linux, ChromeOS (Chromium-based browsers and desktop Firefox, Manifest V3)',
		browserRequirements: 'Requires a Chromium-based browser, version 116 or newer, or desktop Firefox 140 or newer',
		softwareVersion: SITE.version,
		downloadUrl: SITE.releases,
		installUrl: SITE.chromeWebStore,
		license: SITE.license,
		isAccessibleForFree: true,
		offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
		author: {'@type': 'Person', name: SITE.author},
		publisher: {'@id': `${SITE.url}/#organization`},
		codeRepository: SITE.repo,
		screenshot: abs('/og.png'),
		featureList: features.map((f) => f.title),
	},
	{
		'@type': 'FAQPage',
		'@id': `${SITE.url}/#faq`,
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: {'@type': 'Answer', text: f.a},
		})),
	},
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/webp"
		imagesrcset={heroDark.srcset}
		imagesizes={heroSizes}
		media="(prefers-color-scheme: dark)"
		fetchpriority="high"
	/>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/webp"
		imagesrcset={heroLight.srcset}
		imagesizes={heroSizes}
		media="(prefers-color-scheme: light)"
		fetchpriority="high"
	/>

	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">Free &amp; open source</p>
			<h1>Sessions and bookmarks in one quiet place.</h1>
			<p class="lead">Save tabs for later. Restore them with tab groups intact.</p>
			<div class="actions">
				<a class="btn primary" href={SITE.chromeWebStore} rel="noopener"><ButtonIcon kind="store" />Install from Chrome Web Store</a>
				<a class="btn ghost" href={SITE.firefoxAddons} rel="noopener"><ButtonIcon kind="store" />Get for Firefox</a>
				<a class="btn ghost" href={SITE.repo} rel="noopener"><ButtonIcon kind="github" />View on GitHub</a>
			</div>
			<p class="note">
				TabLodge v{SITE.version} &middot; Chrome 116+ &middot; Firefox 140+ &middot; MIT license
			</p>
			<div class="hero-shot">
				<Screenshot
					name="dashboard"
					alt="TabLodge dashboard with saved tab sessions above a board of bookmark columns"
					sizes={heroSizes}
					eager
				/>
			</div>
		</div>
	</section>

	<section id="features" class="alt">
		<div class="wrap">
			<p class="eyebrow">Features</p>
			<h2>What it does</h2>
			<ul class="grid">
				{
					features.map((f) => (
						<li class="card">
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section>
		<div class="wrap split">
			<div>
				<p class="eyebrow">Search</p>
				<h2>Find it all.</h2>
				<p class="lead">Search sessions, bookmarks, and open tabs in one place.</p>
			</div>
			<Screenshot
				name="palette"
				alt="TabLodge command palette searching for 'lis' and listing a session, a bookmark and saved tabs"
				sizes="(min-width: 900px) 540px, calc(100vw - 2.5rem)"
				widths={[540, 1080, 1520]}
			/>
		</div>
	</section>

	<section class="alt">
		<div class="wrap split reverse">
			<div class="sidepanel-shot">
				<Screenshot
					name="sidepanel"
					alt="TabLodge side panel listing bookmark columns with a search box and Bookmarks, Sessions and Tabs tabs"
					sizes="(min-width: 900px) 320px, 60vw"
					widths={[420, 640, 840]}
				/>
			</div>
			<div>
				<p class="eyebrow">Side panel</p>
				<h2>Always one click away</h2>
				<p class="lead">Browse sessions, bookmarks, and open tabs beside your page.</p>
			</div>
		</div>
	</section>

	<section id="privacy">
		<div class="wrap split">
			<div>
				<p class="eyebrow">Privacy</p>
				<h2>Your tabs stay yours</h2>
				<p class="lead">Your library stays in your browser. No account, tracking, or website access.</p>
			</div>
			<p><a class="btn ghost" href="/privacy/">Read the privacy policy</a></p>
		</div>
	</section>

	<section id="faq">
		<div class="narrow">
			<p class="eyebrow">FAQ</p>
			<h2>Quick answers</h2>
			<div class="faq">
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section id="install" class="cta">
		<div class="wrap center">
			<h2>Give your tabs a lodge</h2>
			<div class="actions center">
				<a class="btn primary" href={SITE.chromeWebStore} rel="noopener"><ButtonIcon kind="store" />Install from Chrome Web Store</a>
				<a class="btn ghost" href={SITE.firefoxAddons} rel="noopener"><ButtonIcon kind="store" />Get for Firefox</a>
				<a class="btn ghost" href={SITE.repo} rel="noopener"><ButtonIcon kind="github" />View on GitHub</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero {
		padding-top: 3.5rem;
		padding-bottom: 3rem;
	}
	.hero h1 {
		max-width: 18ch;
	}
	.hero-shot {
		margin-top: 2.2rem;
	}
	.grid {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.1rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
	}
	.card {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.3rem 1.3rem 0.5rem;
	}
	.card p {
		color: var(--muted);
		font-size: 0.98rem;
	}
	.split {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1fr 1fr;
		}
		.split.reverse {
			grid-template-columns: 320px 1fr;
			gap: 4rem;
		}
	}
	.sidepanel-shot {
		max-width: 320px;
		width: 60vw;
		justify-self: center;
	}
	.faq details {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		margin-bottom: 0.7rem;
		padding: 0 1.2rem;
	}
	.faq summary {
		cursor: pointer;
		font-weight: 650;
		padding: 1rem 0;
	}
	.faq details[open] summary {
		color: var(--link);
	}
	.faq p {
		color: var(--muted);
	}
	.center {
		text-align: center;
	}
	.actions.center {
		justify-content: center;
	}
	.cta {
		padding-block: 5rem;
	}
</style>
