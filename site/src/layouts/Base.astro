---
import ButtonIcon from '../components/ButtonIcon.astro';
import '../styles/global.css';
import {SITE, abs} from '../site';

interface Crumb {
	name: string;
	path: string;
}
interface Props {
	title: string;
	description: string;
	path: string;
	ogType?: string;
	breadcrumbs?: Crumb[];
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
}
const {title, description, path, ogType = 'website', breadcrumbs, jsonLd = [], noindex = false} = Astro.props;
const canonical = abs(path);

const graph: Record<string, unknown>[] = [
	{
		'@type': 'WebSite',
		'@id': `${SITE.url}/#website`,
		url: `${SITE.url}/`,
		name: SITE.name,
		description: SITE.defaultDescription,
		inLanguage: 'en',
		publisher: {'@id': `${SITE.url}/#organization`},
	},
	{
		'@type': 'Organization',
		'@id': `${SITE.url}/#organization`,
		name: SITE.name,
		url: `${SITE.url}/`,
		logo: abs('/icon-512.png'),
		sameAs: [SITE.repo],
	},
	...jsonLd,
];
if (breadcrumbs) {
	graph.push({
		'@type': 'BreadcrumbList',
		itemListElement: breadcrumbs.map((c, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: c.name,
			item: abs(c.path),
		})),
	});
}
const structured = JSON.stringify({'@context': 'https://schema.org', '@graph': graph});
const nav = [
	{href: '/#features', label: 'Features'},
	{href: '/#install', label: 'Install'},
	{href: '/alternatives/', label: 'Alternatives'},
	{href: '/#faq', label: 'FAQ'},
];

type FooterLink = {href: string; label: string; icon?: 'store' | 'github'};
const footerGroups: Array<{title: string; links: FooterLink[]}> = [
	{
		title: 'Get TabLodge',
		links: [
			{href: SITE.chromeWebStore, label: 'Chrome Web Store', icon: 'store'},
			{href: SITE.firefoxAddons, label: 'Firefox Add-ons', icon: 'store'},
			{href: SITE.releases, label: 'Latest release'},
			{href: '/alternatives/', label: 'Alternatives'},
		],
	},
	{
		title: 'Project',
		links: [
			{href: SITE.repo, label: 'GitHub', icon: 'github'},
			{href: SITE.issues, label: 'Report an issue'},
			{href: SITE.license, label: 'MIT License'},
		],
	},
	{
		title: 'Legal',
		links: [
			{href: '/privacy/', label: 'Privacy'},
			{href: '/terms/', label: 'Terms'},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
		<meta name="theme-color" content="#fbfaff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0d0b1a" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={abs(SITE.ogImage)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="TabLodge dashboard showing saved tab sessions and a bookmark board" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={abs(SITE.ogImage)} />
		<meta name="twitter:image:alt" content="TabLodge dashboard showing saved tab sessions and a bookmark board" />
		<slot name="head" />
		<script type="application/ld+json" set:html={structured} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="wrap bar">
				<a class="brand" href="/" aria-label="TabLodge home">
					<img src="/favicon.svg" alt="" width="30" height="30" />
					<span>TabLodge</span>
				</a>
				<nav aria-label="Main">
					<ul>
						{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
						<li><a class="gh" href={SITE.repo} rel="noopener" aria-label="GitHub"><ButtonIcon kind="github" /><span class="gh-label">GitHub</span></a></li>
					</ul>
				</nav>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap foot">
				<div class="foot-about">
					<a class="brand" href="/">
						<img src="/favicon.svg" alt="" width="26" height="26" />
						<span>TabLodge</span>
					</a>
					<p>A cozy home for your tabs that keeps everything in your browser. Free and open source.</p>
				</div>
				<nav class="foot-links" aria-label="Footer">
					{footerGroups.map((group) => (
						<div>
							<h2>{group.title}</h2>
							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
											{link.icon && <ButtonIcon kind={link.icon} />}
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</nav>
			</div>
			<p class="wrap legal">
				&copy; 2026 Berkay. TabLodge is not affiliated with Google, Mozilla, Brave, Microsoft or any other product named on this site.
			</p>
		</footer>
	</body>
</html>

<style is:global>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
		flex-wrap: wrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 750;
		font-size: 1.15rem;
		color: var(--text);
		text-decoration: none;
	}
	.site-header ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem;
	}
	.site-header a:not(.brand) {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		color: var(--text);
		font-weight: 600;
		font-size: 0.97rem;
		text-decoration: none;
	}
	.site-header a:not(.brand):hover {
		background: var(--bg-alt);
	}
	.site-header .gh {
		border: 1px solid var(--line);
		margin-left: 0.35rem;
	}
	.site-header .gh:hover {
		border-color: var(--brand);
	}
	.site-header svg,
	.site-footer svg {
		width: 1.05em;
		height: 1.05em;
		flex: none;
		fill: currentColor;
	}
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 3rem 0 2rem;
		background: var(--bg-alt);
	}
	.foot {
		display: flex;
		justify-content: space-between;
		gap: 2.5rem;
		flex-wrap: wrap;
	}
	.foot-about {
		max-width: 22rem;
	}
	.foot-about p {
		color: var(--muted);
		margin: 0.75rem 0 0;
	}
	.foot-links {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem 3.5rem;
	}
	.foot-links h2 {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.85rem;
	}
	.foot-links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	.foot-links a {
		display: inline-flex;
		min-height: 1.5rem;
		align-items: center;
		gap: 0.45rem;
		color: var(--text);
		font-weight: 550;
		text-decoration: none;
	}
	.foot-links a:hover {
		color: var(--link);
		text-decoration: underline;
	}
	.legal {
		margin-top: 2.5rem;
		margin-bottom: 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.9rem;
	}
	@media (max-width: 560px) {
		.bar {
			padding-block: 0.5rem;
			gap: 0.25rem;
		}
		.site-header ul {
			margin-left: -0.6rem;
			gap: 0;
		}
		.site-header a:not(.brand) {
			padding: 0.45rem 0.6rem;
			font-size: 0.95rem;
		}
		/* The icon alone keeps the menu on one row on phones; the link keeps its name through aria-label. */
		.gh-label {
			display: none;
		}
		.foot-links {
			gap: 2rem 2.5rem;
		}
	}
</style>
