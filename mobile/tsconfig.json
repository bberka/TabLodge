{
	// The Android app (React Native). Expo's base config supplies JSX and the Metro module rules.
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"tsBuildInfoFile": "../node_modules/.tmp/tsconfig.mobile.tsbuildinfo"
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
