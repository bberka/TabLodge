// The sync server for the "Deploy to Cloudflare" button (see README.md). worker.js is generated from server/src;
// the binding, class, and migration match server/wrangler.jsonc, so either way of deploying keeps the same library.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tablodge-sync",
	"main": "worker.js",
	"compatibility_date": "2026-10-01",
	"observability": {"enabled": true},
	"durable_objects": {
		"bindings": [{"name": "LIBRARY", "class_name": "SyncLibrary"}],
	},
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["SyncLibrary"]}],
	"vars": {
		"MAX_RECORDS": "500000",
		"RETENTION_DAYS": "90",
		"RATE_LIMIT_PER_MINUTE": "300",
	},
}
